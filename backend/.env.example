# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token
# Public HTTPS URL where the frontend (Mini App) is hosted
WEBAPP_URL=https://blush-slice.example.com
# Public HTTPS URL of this backend. If set, the bot uses a webhook; if empty, long polling.
PUBLIC_API_URL=
# Random string used to protect the webhook path
WEBHOOK_SECRET=change-me-long-random-string
# Chat id (group or user) that receives new-order notifications
ADMIN_CHAT_ID=
SUPPORT_USERNAME=blushslice_support

# ── Payments ──────────────────────────────────────────────
# Provider tokens from @BotFather → Payments (Click / Payme). Leave empty to hide a method.
CLICK_PROVIDER_TOKEN=
PAYME_PROVIDER_TOKEN=
# Telegram Stars need no provider token. How many UZS one Star is worth:
UZS_PER_STAR=220
# @CryptoBot Crypto Pay API token (https://help.crypt.bot/crypto-pay-api). Empty = crypto hidden.
CRYPTOPAY_TOKEN=
CRYPTOPAY_TESTNET=true
CRYPTO_ASSET=USDT
UZS_PER_USD=12800

# ── Database (NeonDB / any PostgreSQL) ────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/blushslice?sslmode=verify-full
DB_SSL=true

# ── Server ────────────────────────────────────────────────
PORT=3100
NODE_ENV=development
# Comma-separated list of allowed origins for the Mini App
CORS_ORIGINS=http://localhost:5180
# Only honoured when NODE_ENV=development: lets you open the Mini App in a normal browser
DEV_SKIP_AUTH=false
LOG_FILE=logs/app.log
